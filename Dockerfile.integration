FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY . .
RUN mvn -B -pl fund-integration -am package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/fund-integration/target/fund-integration-0.0.1-SNAPSHOT-exec.jar app.jar
EXPOSE 18081
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
